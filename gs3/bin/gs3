#!/usr/bin/env bash
# gs3: Gentle Shell (gs2, isolated install) + gs3-hud telemetry sidecar in herdr.
#
# Inside herdr : splits the current pane (gs2 left ~75%, sidecar right ~25%),
#                keeps focus on gs2, closes the sidecar when gs2 exits.
# Outside herdr: creates a herdr workspace for $PWD, runs gs3 inside it, attaches.
# Telemetry: explicitly loads its session bridge; --gs3-herdr-* flags are reserved.
# PROF: the sidecar inherits no Pi environment, so the routing homes present here are
#       forwarded to it (absolute only): GENTLE_PI_CONFIG_HOME, GENTLE_SHELL_CONFIG_HOME,
#       GENTLE_PI_AGENT_HOME, PI_CODING_AGENT_DIR. A bundled <prefix>/agent + <prefix>/config
#       is derived by the HUD itself.
#
# Overrides (mainly for testing):
#   GS3_SHELL  command for the big pane   (macOS: gentle-shell; Linux: gentle-shell2, then pi)
#   GS3_HERDR  path to herdr (default: PATH, then ~/.local/bin/herdr)
#   GS3_HUD    path to the gs3-hud binary (default: <repo>/target/release/gs3-hud)
#   GS3_RATIO  split ratio for the big pane (default: 0.75)
#   GS3_CONFIG sidecar settings file, the only file it writes (default: ~/.config/gs3/gs3-hud.json)
#   GS3_NO_ATTACH=1  outside herdr: create the workspace but do not attach
set -u

SELF="$(realpath "${BASH_SOURCE[0]}")"
REPO="$(cd "$(dirname "$SELF")/../.." && pwd)"
if [ "$(uname -s)" = Darwin ]; then
  SHELL_CMD="${GS3_SHELL:-$(command -v gentle-shell || { [ -x "$HOME/.local/bin/gentle-shell" ] && printf '%s' "$HOME/.local/bin/gentle-shell"; })}"
else
  SHELL_CMD="${GS3_SHELL:-$(command -v gentle-shell2 || command -v pi || true)}"
fi
RATIO="${GS3_RATIO:-0.75}"
CONFIG="${GS3_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/gs3/gs3-hud.json}"
HERDR="${GS3_HERDR:-$(command -v herdr || { [ -x "$HOME/.local/bin/herdr" ] && printf '%s' "$HOME/.local/bin/herdr"; })}"

die() { printf 'gs3: %s\n' "$*" >&2; exit 1; }

case "${1:-}" in
  -h|--help)
    sed -n '2,19p' "$SELF" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

[ -n "$HERDR" ] || die "herdr not found in PATH"
[ -n "$SHELL_CMD" ] || die "no agent shell found: install gentle-shell or set GS3_SHELL"
# Reject caller-supplied binding flags before any pane/workspace side effects.
for arg in "$@"; do
  [ "$arg" = -- ] && break
  case "$arg" in
    --gs3-herdr-pane|--gs3-herdr-pane=*|--gs3-herdr-socket|--gs3-herdr-socket=*)
      die "${arg%%=*} is reserved for the gs3 session bridge" ;;
  esac
done

find_hud() {
  local c
  for c in "${GS3_HUD:-}" "$(dirname "$SELF")/gs3-hud" "$REPO/target/release/gs3-hud" "$(command -v gs3-hud 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

quote_args() { local out="" a; for a in "$@"; do out+=" $(printf '%q' "$a")"; done; printf '%s' "$out"; }

# Every rail pane bound to this pane. The pane id captured at startup goes stale the moment the
# rail is re-created (a manual restart, a second gs3), and closing only that id is exactly how
# `/quit` leaves a panel hooked to the side: no shell there reads `q` any more.
rail_panes() {
  local me="$1" pane cmd
  "$HERDR" pane list 2>/dev/null | jq -r '.result.panes[].pane_id' 2>/dev/null | while read -r pane; do
    [ -n "$pane" ] || continue
    [ "$pane" = "$me" ] && continue
    cmd="$("$HERDR" pane process-info --pane "$pane" 2>/dev/null | jq -r '.result.process_info.foreground_processes[].cmdline // empty' 2>/dev/null | head -1)"
    case " $cmd " in *gs3-hud*"--pane $me "*) printf '%s\n' "$pane" ;; esac
  done
}

close_rails() {
  local pane
  for pane in $(rail_panes "$1"); do "$HERDR" pane close "$pane" >/dev/null 2>&1; done
  return 0
}

# Runs for every exit path, including Ctrl-C and a terminal hangup.
close_sidecar() {
  [ -n "${HUD_PANE:-}" ] && "$HERDR" pane close "$HUD_PANE" >/dev/null 2>&1
  close_rails "${HERDR_PANE_ID:-}"
}

# Routing homes the sidecar reads for PROF: only the explicit absolute ones.
routing_env() {
  local out="" name value
  for name in GENTLE_PI_CONFIG_HOME GENTLE_SHELL_CONFIG_HOME GENTLE_PI_AGENT_HOME PI_CODING_AGENT_DIR; do
    value="${!name:-}"
    [ -n "$value" ] || continue
    case "$value" in /*) ;; *) continue ;; esac
    out+="$name=$(printf '%q' "$value") "
  done
  printf '%s' "$out"
}

inside_herdr() {
  local me="${HERDR_PANE_ID:?}" hud bridge socket
  # Bind telemetry explicitly: Gentle Shell intentionally rebuilds Pi's environment.
  bridge="$(dirname "$SELF")/../share/gs3/herdr-session/index.ts"
  [ -f "$bridge" ] || bridge="$REPO/extensions/herdr-session/index.ts"
  [ -f "$bridge" ] || die "session bridge missing: reinstall the gs3 launcher"
  bridge="$(realpath "$bridge")"
  socket="${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}"
  case "$socket" in /*) ;; *) die "HERDR_SOCKET_PATH must be an absolute path" ;; esac
  HUD_PANE=""   # global: the EXIT trap runs after this function returns
  trap close_sidecar EXIT
  if hud="$(find_hud)"; then
    close_rails "$me"   # a rail left behind by an earlier run would stack a second panel
    HUD_PANE="$("$HERDR" pane split "$me" --direction right --ratio "$RATIO" \
      --cwd "$PWD" --no-focus | jq -r '.result.pane.pane_id // empty')"
    if [ -n "$HUD_PANE" ]; then
      # The HUD never creates directories: pass --config only when its folder exists.
      local cfg=""; [ -d "$(dirname "$CONFIG")" ] && cfg=" --config $(printf '%q' "$CONFIG")"
      local routing; routing="$(routing_env)"
      "$HERDR" pane run "$HUD_PANE" \
        "${routing}GS3_SHELL=$(printf '%q' "$SHELL_CMD") GS3_HERDR=$(printf '%q' "$HERDR") exec $(printf '%q' "$hud") --pane $(printf '%q' "$me") --cwd $(printf '%q' "$PWD")$cfg" >/dev/null \
        || printf 'gs3: could not start sidecar in %s\n' "$HUD_PANE" >&2
      # Close the sidecar whenever gs2 ends (normal exit, Ctrl-C, terminal hangup).
      trap 'exit 130' INT
      trap 'exit 143' TERM HUP
    else
      printf 'gs3: pane split failed; running gs2 without sidecar\n' >&2
    fi
  else
    printf 'gs3: gs3-hud not built (cargo build --release in %s/gs3/hud); running gs2 alone\n' "$REPO" >&2
  fi
  "$SHELL_CMD" --extension "$bridge" --gs3-herdr-pane "$me" --gs3-herdr-socket "$socket" "$@"
}

outside_herdr() {
  command -v jq >/dev/null || die "jq not found in PATH"
  if ! "$HERDR" status server >/dev/null 2>&1; then
    if [ "$(uname -s)" = Darwin ]; then
      (nohup "$HERDR" server </dev/null >/dev/null 2>&1 &)
    else
      (setsid "$HERDR" server >/dev/null 2>&1 &)
    fi
    local i
    for i in $(seq 50); do "$HERDR" status server >/dev/null 2>&1 && break; sleep 0.1; done
    "$HERDR" status server >/dev/null 2>&1 || die "herdr server did not start"
  fi
  local label ws root
  label="$(basename "$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")")"
  local focus=--focus
  [ "${GS3_NO_ATTACH:-0}" = 1 ] && focus=--no-focus
  ws="$("$HERDR" workspace create --cwd "$PWD" --label "gs3 · $label" "$focus")" || die "workspace create failed"
  root="$(printf '%s' "$ws" | jq -r '.result.root_pane.pane_id // empty')"
  [ -n "$root" ] || die "workspace create returned no root pane"
  local env_prefix=""
  env_prefix+="GS3_SHELL=$(printf '%q' "$SHELL_CMD") GS3_HERDR=$(printf '%q' "$HERDR") "
  [ -n "${GS3_HUD:-}" ] && env_prefix+="GS3_HUD=$(printf '%q' "$GS3_HUD") "
  [ -n "${GS3_RATIO:-}" ] && env_prefix+="GS3_RATIO=$(printf '%q' "$GS3_RATIO") "
  [ -n "${GS3_CONFIG:-}" ] && env_prefix+="GS3_CONFIG=$(printf '%q' "$GS3_CONFIG") "
  # No exec: when gs2 exits the user stays in that pane's shell.
  "$HERDR" pane run "$root" "${env_prefix}$(printf '%q' "$SELF")$(quote_args "$@")" >/dev/null \
    || die "could not start gs3 in $root"
  [ "${GS3_NO_ATTACH:-0}" = 1 ] && { printf '%s\n' "$ws"; exit 0; }
  exec "$HERDR"
}

if [ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ]; then
  inside_herdr "$@"
else
  outside_herdr "$@"
fi
